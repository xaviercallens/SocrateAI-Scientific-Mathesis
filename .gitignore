# Rust
rust/*/target/

# Lean
.lake/
*.olean
*.ilean
*.trace

# Python
__pycache__/
*.py[cod]
.venv/

# Scratch — no versioned copies, no scratch files in tracked trees (SPEC.md §7.4)
*.tmp
corpus/

# Local Claude Code settings and transients
.claude/settings.local.json
.claude/*.tmp.*

# LaTeX build artifacts — the .tex and the built .pdf are tracked, nothing else
latex/*.aux
latex/*.log
latex/*.out
latex/*.toc
latex/*.fls
latex/*.fdb_latexmk
latex/*.xdv
latex/*.synctex.gz
